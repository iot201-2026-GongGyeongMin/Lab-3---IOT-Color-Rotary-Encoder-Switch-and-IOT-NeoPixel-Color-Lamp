    {
        "id": "3b61a29b166ad15f",
        "type": "function",
        "z": "d1ea13bb24642f67",
        "name": "on/off?",
        "func": "let off_state = { \"r\": 0, \"g\": 0, \"b\": 0 };\nfunction isEqual(a, b) {\n    for(let c in a) {\n        if (a[c] != b[c]) {\n            return false;\n        }\n    }\n    return true;\n}\n\nmsg.payload = isEqual(msg.payload.d.color, off_state) ? 'off' : 'on';\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
