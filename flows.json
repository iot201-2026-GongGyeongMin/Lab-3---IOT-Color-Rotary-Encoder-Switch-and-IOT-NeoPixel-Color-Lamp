        "z": "d1ea13bb24642f67",
        "name": "on/off",
        "func": "let color = {\"r\": 0, \"g\": 0, \"b\": 0};\nlet saved = flow. get('level_save');\nmsg. level = saved;\nif (msg.payload === 'on') {\n    color = {\"r\": saved, \"g\": saved, \"b\": saved}\n} else {\n    flow. set('level_save', flow. get( 'level'));\n}\nmsg. payload = {\"d\": {\"color\" : color}};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
