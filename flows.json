    {
        "id": "821a4b43508449b1",
        "type": "function",
        "z": "d1ea13bb24642f67",
        "name": "on/off",
        "func": "if (msg.payload === 'on') {\n    msg.payload = {\"d\": {\"value\" : flow.get('level_save')}};\n} else {\n    flow. set('level_save', flow. get('level'));\n    msg.payload = {\"d\": {\"value\" : 0}};\n}\nreturn msg;",
        "outputs": 1,
