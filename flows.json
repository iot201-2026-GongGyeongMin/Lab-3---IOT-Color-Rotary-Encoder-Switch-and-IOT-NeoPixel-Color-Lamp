        "z": "d1ea13bb24642f67",
        "name": "rotary",
        "func": "let level = 0;\nif (msg.payload.d. switch === 'clicked') {\n    if (flow.get('level') === 0) {\n        level = flow. get( 'level_save');\n    }\n} else {\n    level = msg.payload.d.value;\n}\nmsg. payload = {\n    \"d\": { \"color\": {\"r\": level, \"g\": level, \"b\": level }\n    }\n}\nreturn msg;",
